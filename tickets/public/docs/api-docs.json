                "operationId": "c81d7706b9abe5413cc0cef6e8e1af1d",
                "parameters": [
                    {
                        "name": "ticketType",
                        "in": "path",
                        "description": "Ticket Type ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
