FROM php:8.2-fpm

# Instaliraj zavisnosti
RUN apt-get update && apt-get install -y \
    git \
    curl \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    zip \
    unzip

# Očisti cache
RUN apt-get clean && rm -rf /var/lib/apt/lists/*

# Instaliraj PHP ekstenzije
RUN docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd zip

# Instaliraj Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Postavi radni direktorijum
WORKDIR /var/www

# Kopiraj SAMO composer fajlove prvo
COPY composer.json composer.lock ./

# Instaliraj SVE zavisnosti (uključujući dev)
RUN composer install --optimize-autoloader --no-scripts --no-autoloader

# Kopiraj ostatak projekta
COPY . /var/www

# Generiši autoloader BEZ scripts
RUN composer dump-autoload --optimize --no-scripts

# Dodaj permissions
RUN chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache
RUN chmod -R 775 /var/www/storage /var/www/bootstrap/cache

# Expose port
EXPOSE 8000

# Pokreni Laravel server
CMD php artisan serve --host=0.0.0.0 --port=8000